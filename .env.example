# ================= 复制此文件为 .env，然后填写实际值 =================
# 注意：.env 已加入 .gitignore，不会提交到代码仓库

# ============ 服务配置 ============
# FastAPI 监听地址和端口
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# 允许的前端域名（开发时Vite默认5173），多个用逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============ MySQL 业务数据库（会话元数据） ============
# 格式：mysql+aiomysql://用户名:密码@主机:端口/数据库名?charset=utf8mb4
MYSQL_URL=mysql+aiomysql://root:your_password@127.0.0.1:3306/power_agent?charset=utf8mb4

# ============ LLM 配置 ============
# LLM API Key（从阿里百炼/DeepSeek等平台获取）
LLM_API_KEY=sk-your-actual-api-key-here

# LLM API 地址（兼容 OpenAI 格式的地址）
# 阿里云百炼示例：https://xxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# DeepSeek 示例：https://api.deepseek.com/v1
LLM_API_URL=https://llm-xxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# LangChain 用的 base_url（一般和上面同地址，去掉末尾 /chat/completions）
LLM_API_URL_LANGCHAIN=https://llm-xxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# 模型名称
LLM_MODEL=deepseek-v4-pro-0813

# LLM 采样温度（越低越稳定，推荐 0.1）
LLM_TEMPERATURE=0.1

# 单次响应最大 token 数
LLM_MAX_TOKENS=2048

# 超时秒数
LLM_TIMEOUT=60